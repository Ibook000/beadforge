# ===== Picabead 激活码系统 · 环境变量模板 =====
# 复制为 .env 并填入真实值。.env 已被 gitignore，不会提交。
# 注意：前端只会用到 publishable key（设计为公开）。secret key 绝不放这里。

# Supabase 项目地址（Settings → API → Project URL）
VITE_SUPABASE_URL=https://xxxx.supabase.co

# Supabase publishable / anon key（Settings → API → Public anon key / publishable key）
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxx
